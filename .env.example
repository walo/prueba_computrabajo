# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR AGENTS, API & DOCKER INFRASTRUCTURE
# ==============================================================================
# Copy this file to .env in the repository root and fill in your credentials:
# cp .env.example .env
# NEVER commit .env with real credentials to version control (Git).

# ------------------------------------------------------------------------------
# 1. JIRA CLOUD (User Stories Automation, Sprints & Traceability)
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=user@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# ------------------------------------------------------------------------------
# 2. GITHUB AUTOMATION & CLI (Pull Requests, Branches & Releases)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ------------------------------------------------------------------------------
# 3. NOTEBOOKLM (Business Grounding & Single Source of Truth)
# ------------------------------------------------------------------------------
NOTEBOOKLM_NOTEBOOK_ID=your_notebook_id_here

# ------------------------------------------------------------------------------
# 4. LOCAL DATABASE & CACHE (SQL Server 2022 + Redis 7 Docker Compose)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=RedarborInventoryDb
DB_USER=sa
DB_PASSWORD=RedarborStrongPass123!
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. OAUTH2 / JWT AUTHENTICATION SETTINGS
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=SuperSecretRedarborEnterpriseJwtKey2026WithAtLeast32Bytes!
JWT_ISSUER=RedarborInventoryApi
JWT_AUDIENCE=RedarborInventoryClient
JWT_ACCESS_TOKEN_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:4200
